/* =====================================================================
   CONTACT PAGE — NHÀ HÀNG PHÌ LŨ  (/lien-he)
   Scoped to the public contact page. All classes are prefixed with
   `contact-` so they never collide with site.css / home.css /
   venues.css / halls.css / booking.css.

   Visual direction — formal luxury wedding:
     * A quiet ivory / champagne / deep-brown palette. The strong
       "card cream" yellow of the invitation pages is deliberately
       NOT used here: a contact page should read like the concierge
       desk of a fine hotel, not like a printed invitation card.
     * One serif (Newsreader) for the major headings, one sans
       (Source Sans 3) for everything else. No italic anywhere on
       the page — the accent is carried by a champagne rule and by
       the spacing, not by slanted type.
     * Labels are sentence case. The uppercase voice is reserved for
       the primary button, which is the one place the site expects
       it.
     * Photography is treated as editorial: images run to the edge of
       their frame and are overprinted with a hairline gold rule,
       the way a magazine treats a full-bleed picture.
   ===================================================================== */

/* ---------- Page-level typography ---------- */
.contact-eyebrow {
    /* Sentence case, open tracking: the eyebrow marks a section, it
       does not stamp it. */
    text-transform: none;
    letter-spacing: var(--ls-body);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
}

.contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    /* Keeps the underline attached to the words while still giving
       the link a ~44px tap target. */
    padding: 0.625rem 0;
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ls-body);
    line-height: var(--lh-snug);
    text-transform: none;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    transition: border-color var(--dur-base) var(--ease-soft),
                color var(--dur-base) var(--ease-soft);
}

.contact-link span {
    transition: transform var(--dur-base) var(--ease-soft);
}

.contact-link:hover,
.contact-link:focus-visible {
    color: var(--color-ink);
    border-bottom-color: var(--color-champagne);
}

.contact-link:hover span,
.contact-link:focus-visible span {
    transform: translateX(5px);
}

/* The inverted variant sits on the deep-brown hotline panel. */
.contact-link--invert {
    color: var(--color-paper);
    border-bottom-color: rgba(248, 246, 240, 0.32);
}

.contact-link--invert:hover,
.contact-link--invert:focus-visible {
    color: var(--color-champagne);
    border-bottom-color: var(--color-champagne);
}

/* The secondary button of a venue card: sentence case, so the
   primary call to action keeps the upper-case voice to itself. */
.contact-btn {
    text-transform: none;
    letter-spacing: var(--ls-body);
    font-size: var(--fs-body-sm);
    padding: var(--space-3) var(--space-6);
}

/* ---------- Hero ---------- */
.contact-hero {
    position: relative;
    background-color: var(--color-ivory);
    overflow: hidden;
}

.contact-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9);
    align-items: center;
    padding-top: var(--space-10);
    padding-bottom: var(--space-11);
}

/* The copy column keeps a narrow measure so the headline breaks
   into calm, editorial lines instead of a slab of text. */
.contact-hero__content {
    max-width: 30rem;
}

.contact-hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-text-strong);
    max-width: 15ch;
    text-wrap: balance;
}

/* The single restrained emphasis of the hero: the brand name in the
   deep-brown tone, set on the same baseline as the rest of the
   headline. No italic, no underline gimmick. */
.contact-hero__accent {
    color: var(--color-brown);
    font-weight: var(--font-weight-semibold);
    /* A champagne hairline under the brand name — the one ornament
       the hero is allowed. */
    border-bottom: 1px solid var(--color-champagne);
    padding-bottom: 0.08em;
}

.contact-hero__lede {
    margin-top: var(--space-6);
    font-size: var(--fs-body-lg);
    color: var(--color-text-muted);
    line-height: var(--lh-relaxed);
    max-width: 46ch;
}

.contact-hero__actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-7);
}

.contact-hero__actions .btn,
.contact-hero__actions .contact-link {
    margin-top: 0;
}

/* --- Hero photograph ---
   The picture is full-bleed inside its plate — no cream mat, no
   chamfered frame — and a single champagne rule is overprinted
   slightly inside its edges. That is the editorial treatment used
   by the high-end wedding magazines this page borrows its tone
   from, and it replaces the "framed poster" look. */
.contact-hero__figure {
    position: relative;
    margin: 0;
}

.contact-hero__plate {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-cream);
    box-shadow: 0 22px 60px rgba(44, 36, 28, 0.14);
}

.contact-hero__plate::after {
    content: "";
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(248, 246, 240, 0.42);
    pointer-events: none;
    z-index: 2;
}

.contact-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
}

/* A champagne rule set just outside the plate, offset downwards —
   the detail that makes the photograph read as a laid-out page
   rather than a banner. */
.contact-hero__figure::before {
    content: "";
    position: absolute;
    inset: 18px -18px -18px 18px;
    border: 1px solid var(--color-champagne);
    pointer-events: none;
    z-index: 3;
}

@media (min-width: 900px) {
    .contact-hero__grid {
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
        gap: var(--space-10);
        padding-top: var(--space-12);
        padding-bottom: var(--space-12);
    }

    .contact-hero__content {
        max-width: 32rem;
    }
}

@media (max-width: 599.98px) {
    .contact-hero__figure::before {
        inset: 12px -12px -12px 12px;
    }

    .contact-hero__plate {
        aspect-ratio: 3 / 4;
    }
}

/* ---------- Venue cards ---------- */
.contact-venues {
    padding-top: var(--space-11);
    padding-bottom: var(--space-12);
    background-color: var(--color-paper);
}

.contact-venues__head {
    margin-bottom: var(--space-9);
}

.contact-venues__lede {
    margin-top: var(--space-5);
    font-size: var(--fs-body-lg);
    color: var(--color-text-muted);
    line-height: var(--lh-relaxed);
    max-width: 54ch;
    margin-left: auto;
    margin-right: auto;
}

.contact-venue-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8) var(--space-7);
    max-width: 1080px;
    margin-left: auto;
    margin-right: auto;
}

/* A venue profile rather than a directory listing: a paper-white
   panel with a single hairline border, the photograph bleeding to
   the top edge of the panel, and a champagne hairline that catches
   the light on hover. */
.contact-venue-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease-soft),
                box-shadow var(--dur-base) var(--ease-soft),
                transform var(--dur-base) var(--ease-soft);
}

.contact-venue-card:hover {
    border-color: var(--color-champagne);
    box-shadow: 0 18px 44px rgba(44, 36, 28, 0.10);
    transform: translateY(-2px);
}

.contact-venue-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-cream);
    border-bottom: 1px solid var(--color-line);
}

.contact-venue-card__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 720ms var(--ease-soft);
}

.contact-venue-card:hover .contact-venue-card__media > img {
    transform: scale(1.03);
}

.contact-venue-card__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: clamp(1.75rem, 3vw, 2.5rem);
}

.contact-venue-card__meta {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ls-body);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
}

.contact-venue-card__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.15rem + 1.1vw, 2rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    letter-spacing: var(--ls-serif);
    color: var(--color-text-strong);
    margin-bottom: var(--space-5);
}

/* The address is the piece of information a visitor actually wants
   from this card, so it gets the clearest treatment on the page: a
   quiet champagne rule, the address itself in the readable body
   tone, and generous line-height for the long Vietnamese string. */
.contact-venue-card__address {
    display: block;
    font-style: normal;
    padding: 0 0 0 var(--space-5);
    border-left: 1px solid var(--color-champagne);
    margin-bottom: var(--space-6);
}

.contact-venue-card__address-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ls-body);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
}

.contact-venue-card__address-text {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text);
    /* A long address must never push the card past the viewport. */
    overflow-wrap: anywhere;
}

.contact-venue-card__actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
}

.contact-venue-card__actions .btn,
.contact-venue-card__actions .contact-link {
    margin-top: 0;
}

@media (min-width: 760px) {
    .contact-venue-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-9) var(--space-7);
    }
}

/* ---------- Maps ---------- */
.contact-maps {
    padding-top: var(--space-11);
    padding-bottom: var(--space-12);
    background-color: var(--color-ivory);
}

.contact-maps__head {
    margin-bottom: var(--space-9);
}

.contact-map-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8) var(--space-7);
}

.contact-map {
    margin: 0;
    min-width: 0;
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
}

.contact-map__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-cream);
    border-bottom: 1px solid var(--color-line);
}

.contact-map__embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
}

.contact-map__caption {
    padding: var(--space-6) clamp(1.25rem, 3vw, 2rem) var(--space-7);
}

.contact-map__name {
    font-family: var(--font-serif);
    font-size: var(--fs-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-serif);
    color: var(--color-text-strong);
    margin-bottom: var(--space-2);
}

.contact-map__address {
    font-size: var(--fs-body-sm);
    color: var(--color-text-muted);
    line-height: var(--lh-body);
    margin-bottom: var(--space-4);
    overflow-wrap: anywhere;
}

@media (min-width: 900px) {
    .contact-map-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-8);
    }

    .contact-map__frame {
        aspect-ratio: 16 / 11;
    }
}

/* ---------- Contact channels ---------- */
.contact-channels {
    padding-top: var(--space-11);
    padding-bottom: var(--space-12);
    background-color: var(--color-paper);
}

.contact-channels__head {
    margin-bottom: var(--space-9);
}

.contact-channels__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 1140px;
    margin-left: auto;
    margin-right: auto;
}

.contact-channel {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    background-color: var(--color-ivory);
    border: 1px solid var(--color-border);
    position: relative;
}

/* A short champagne rule at the top-left of each panel — a single
   ornament, repeated, instead of a full-width band. */
.contact-channel::before {
    content: "";
    position: absolute;
    top: 0;
    left: clamp(1.75rem, 3.5vw, 2.75rem);
    width: 40px;
    height: 2px;
    background-color: var(--color-champagne);
}

.contact-channel__label {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--ls-body);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
}

/* The hotline is the primary channel, so it sits on the deep-brown
   panel — but the number itself is kept at a civil size. The
   priority comes from the contrast of the panel, not from an
   oversized number. */
.contact-channel--hotline {
    background-color: var(--color-brown);
    border-color: var(--color-brown);
}

.contact-channel--hotline::before {
    background-color: var(--color-champagne);
}

.contact-channel--hotline .contact-channel__label {
    color: var(--color-champagne);
}

.contact-channel__hotline {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.375rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.15;
    letter-spacing: var(--ls-serif);
    color: var(--color-paper);
    margin-bottom: var(--space-4);
    font-variant-numeric: lining-nums tabular-nums;
    transition: color var(--dur-base) var(--ease-soft);
}

.contact-channel__hotline:hover,
.contact-channel__hotline:focus-visible {
    color: var(--color-champagne);
}

.contact-channel__body {
    font-size: var(--fs-body-sm);
    color: var(--color-text-muted);
    line-height: var(--lh-body);
    max-width: 40ch;
}

/* The hotline panel carries inverted text, so its body copy needs the
   lighter tone to stay readable on the dark brown fill. */
.contact-channel--hotline .contact-channel__body {
    color: rgba(248, 246, 240, 0.78);
}

.contact-channel .contact-link {
    margin-top: auto;
    padding-top: var(--space-5);
    align-self: flex-start;
}

@media (min-width: 900px) {
    .contact-channels__grid {
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: var(--space-6);
        align-items: stretch;
    }
}

/* ---------- Closing CTA ---------- */
.contact-closing {
    padding-top: var(--space-11);
    padding-bottom: var(--space-12);
    background-color: var(--color-ivory);
}

.contact-closing__inner {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
}

.contact-closing__frame {
    position: relative;
    padding: clamp(2.5rem, 4vw, 4.5rem) clamp(1.75rem, 4vw, 3.5rem);
    text-align: center;
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
}

/* A single hairline rule inset from the frame — restrained, formal,
   and no longer fighting the corner ornaments for attention. */
.contact-closing__frame::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid var(--color-line);
    pointer-events: none;
}

.contact-closing__frame::after {
    content: "";
    position: absolute;
    inset: 18px;
    pointer-events: none;
    background:
        radial-gradient(circle at 0 0, var(--color-champagne) 0 2px, transparent 3px) top left / 100% 100% no-repeat,
        radial-gradient(circle at 100% 0, var(--color-champagne) 0 2px, transparent 3px) top right / 100% 100% no-repeat,
        radial-gradient(circle at 0 100%, var(--color-champagne) 0 2px, transparent 3px) bottom left / 100% 100% no-repeat,
        radial-gradient(circle at 100% 100%, var(--color-champagne) 0 2px, transparent 3px) bottom right / 100% 100% no-repeat;
}

.contact-closing__frame > * {
    position: relative;
    z-index: 1;
}

.contact-closing__frame .eyebrow {
    justify-content: center;
}

.contact-closing__lede {
    margin: var(--space-6) auto var(--space-8);
    max-width: 46ch;
    font-size: var(--fs-body-lg);
    color: var(--color-text-muted);
    line-height: var(--lh-relaxed);
}

.contact-closing__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-5) var(--space-6);
}

.contact-closing__actions .btn,
.contact-closing__actions .contact-link {
    margin-top: 0;
}

/* ---------- Reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
    .contact-venue-card,
    .contact-venue-card__media > img,
    .contact-link span {
        transition: none;
    }

    .contact-venue-card:hover {
        transform: none;
    }
}
