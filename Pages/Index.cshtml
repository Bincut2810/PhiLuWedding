@page
@model PhiluWedding.Pages.IndexModel
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Trang chủ";
    var brandName = Configuration["Brand:Name"] ?? "NHÀ HÀNG PHÌ LŨ";
}
@* =====================================================================
   HOME PAGE — NHÀ HÀNG PHÌ LŨ
   Customer journey (Phase 12):
     Homepage
       ↓ Choose a wedding venue
       Venue page (4 halls)
       ↓ Choose a hall
       Hall detail (/tiec-cuoi/{id})

   The hero image and intro media still use Unsplash placeholders
   pending Cloudinary delivery; venue / hall images use the public
   static assets under wwwroot/images/venues/.
   ===================================================================== *@

@* ---------- HERO ---------- *@
<section class="hero" aria-label="Giới thiệu nhà hàng">
    <div class="hero__grid">
        <div class="hero__media">
            <img class="hero__image"
                 src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1400&q=80"
                 alt="Không gian sảnh tiệc cưới sang trọng với ánh nến và hoa trắng — hình minh họa tạm thời"
                 loading="eager"
                 fetchpriority="high" />
        </div>
        <div class="hero__content">
            <p class="eyebrow">NHÀ HÀNG TIỆC CƯỚI</p>
            <h1 class="hero__title">
                <span>Nơi hạnh phúc</span>
                <span>được kiến tạo</span>
                <span>bằng từng</span>
                <span>khoảnh khắc</span>
            </h1>
            <p class="hero__lede">
                Không gian sang trọng &mdash; Ẩm thực tinh hoa &mdash; Dịch vụ tận tâm.
            </p>
            <a class="btn btn--primary" href="#chon-nha-hang">
                KHÁM PHÁ KHÔNG GIAN
                <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </div>
    <div class="hero__botanical" aria-hidden="true"></div>
</section>

@* ---------- INTRODUCTION ---------- *@
<section class="intro" aria-labelledby="intro-heading">
    <div class="container">
        <div class="intro__grid">
            <div class="intro__text">
                <p class="eyebrow">VỀ NHÀ HÀNG PHÌ LŨ</p>
                <h2 id="intro-heading" class="section-title">
                    <span>Tinh hoa ẩm thực</span>
                    <span>cho ngày trọng đại</span>
                </h2>
                <p class="intro__lede">
                    Nhà hàng Phì Lũ là điểm đến cho những buổi tiệc cưới sang trọng tại Đà Nẵng.
                    Mỗi không gian được chăm chút tỉ mỉ, mỗi thực đơn được gói ghém tinh tế,
                    để mỗi khoảnh khắc của bạn đều trở nên đáng nhớ.
                </p>
                <a class="link-arrow" href="#chon-nha-hang">
                    TÌM HIỂU THÊM
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
            <div class="intro__media">
                <div class="intro__frame">
                    <img class="intro__image"
                         src="https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=1200&q=80"
                         alt="Sảnh tiệc được trang trí hoa và ánh sáng dịu — hình minh họa tạm thời"
                         loading="lazy" />
                </div>
            </div>
        </div>
    </div>
</section>

@* ---------- VENUE SELECTION ---------- *@
<section class="venues" id="chon-nha-hang" aria-labelledby="venues-heading">
    <div class="container">
        <header class="section-head section-head--center">
            <p class="eyebrow">KHÔNG GIAN TIỆC CƯỚI</p>
            <h2 id="venues-heading" class="section-title">
                <span>Lựa chọn không gian phù hợp</span>
                <span>cho ngày trọng đại của bạn</span>
            </h2>
        </header>

        <ul class="venues__grid" role="list">
            <li class="venue-card">
                <a class="venue-card__link"
                   asp-page="/TiecCuoi/GoldenPhoenix"
                   aria-label="Khám phá Golden Phoenix — nhà hàng tiệc cưới">
                    <div class="venue-card__media">
                        <img src="~/images/venues/golden-phoenix/cover.webp"
                             alt="Golden Phoenix — khu đón khách"
                             loading="lazy"
                             asp-append-version="true" />
                    </div>
                    <div class="venue-card__body">
                        <p class="venue-card__meta">NHÀ HÀNG TIỆC CƯỚI</p>
                        <h3 class="venue-card__title">Golden Phoenix</h3>
                        <p class="venue-card__desc">Không gian tiệc cưới sang trọng với bốn sảnh tiệc theo từng sức chứa.</p>
                        <span class="link-arrow link-arrow--inline">
                            Khám phá sảnh
                            <span aria-hidden="true">&rarr;</span>
                        </span>
                    </div>
                </a>
            </li>
            <li class="venue-card">
                <a class="venue-card__link"
                   asp-page="/TiecCuoi/PhiLu"
                   aria-label="Khám phá Trung tâm Hội nghị Tiệc cưới Phì Lũ">
                    <div class="venue-card__media">
                        <img src="~/images/venues/philu/cover.webp"
                             alt="Trung tâm Hội nghị Tiệc cưới Phì Lũ — sảnh đón khách"
                             loading="lazy"
                             asp-append-version="true" />
                    </div>
                    <div class="venue-card__body">
                        <p class="venue-card__meta">TRUNG TÂM HỘI NGHỊ</p>
                        <h3 class="venue-card__title">Phì Lũ</h3>
                        <p class="venue-card__desc">Trung tâm Hội nghị Tiệc cưới với bốn sảnh tiệc mang tên Amber, Pearl, Diamond, Crystal.</p>
                        <span class="link-arrow link-arrow--inline">
                            Khám phá sảnh
                            <span aria-hidden="true">&rarr;</span>
                        </span>
                    </div>
                </a>
            </li>
        </ul>
    </div>
</section>

@* ---------- BOOKING CTA ---------- *@
<section class="booking" id="dat-tiec" aria-labelledby="booking-heading">
    <div class="container booking__inner">
        <div class="booking__frame">
            <p class="eyebrow">ĐẶT TIỆC &amp; TƯ VẤN</p>
            <h2 id="booking-heading" class="section-title">
                <span>Cùng bạn chuẩn bị</span>
                <span>ngày trọng đại</span>
            </h2>
            <p class="booking__lede">
                Hãy để chúng tôi đồng hành và tư vấn chi tiết cho buổi tiệc của bạn.
                Đội ngũ Phì Lũ sẽ liên hệ lại để cùng bạn trao đổi về không gian và
                phương án tiệc phù hợp — bạn chưa cần quyết định ngay.
            </p>
            <div class="booking__actions">
                <a class="btn btn--outline" asp-page="/DatTiec">
                    LIÊN HỆ TƯ VẤN
                    <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                </a>
                <a class="link-arrow" asp-page="/TiecCuoi">
                    KHÁM PHÁ SẢNH TIỆC
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        </div>
        <div class="booking__botanical" aria-hidden="true"></div>
    </div>
</section>
