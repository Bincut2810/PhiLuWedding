@page "/tiec-cuoi/philu"
@model PhiluWedding.Pages.TiecCuoi.PhiLuModel
@{
    ViewData["Title"] = "Phì Lũ — Trung tâm Hội nghị Tiệc cưới";
}

@section Styles {
    <link rel="stylesheet" href="~/css/halls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/venues.css" asp-append-version="true" />
}

@* =====================================================================
   PHÌ LŨ — TRUNG TÂM HỘI NGHỊ TIỆC CƯỚI — HALL SELECTION
   Shows exactly the four halls that belong to Phì Lũ (Amber, Pearl,
   Diamond, Crystal). Each hall card links to the existing detail
   route /tiec-cuoi/{id}.
   ===================================================================== *@

<section class="halls-page halls-venue" aria-labelledby="venue-halls-heading">
    <div class="container">
        <nav class="halls-detail__crumbs" aria-label="Breadcrumb">
            <a asp-page="/Index">Trang chủ</a>
            <span aria-hidden="true">›</span>
            <a asp-page="/TiecCuoi">Tiệc cưới</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">Trung tâm Hội nghị Tiệc cưới Phì Lũ</span>
        </nav>

        <header class="halls-page__head">
            <p class="eyebrow">TRUNG TÂM HỘI NGHỊ TIỆC CƯỚI PHÌ LŨ</p>
            <h1 id="venue-halls-heading" class="halls-page__title">
                <span>Bốn sảnh tiệc,</span>
                <span>một phong cách</span>
            </h1>
            <p class="halls-page__lede">
                Khám phá các sảnh tiệc của Trung tâm Hội nghị Tiệc cưới Phì Lũ.
                Mỗi sảnh có sức chứa và phong cách riêng, sẵn sàng đồng hành
                cùng ngày trọng đại của bạn.
            </p>
        </header>

        @if (Model.Halls.Count == 0)
        {
            <div class="halls-page__notice" role="status">
                <p class="halls-page__notice-title">Danh sách sảnh tiệc đang được cập nhật.</p>
                <p class="halls-page__notice-body">
                    Phì Lũ đang hoàn thiện hình ảnh và thông tin cho từng sảnh.
                    Xin vui lòng quay lại sau hoặc liên hệ để được tư vấn.
                </p>
                <a class="link-arrow" asp-page="/DatTiec">
                    LIÊN HỆ TƯ VẤN
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        }
        else
        {
            <ul class="venue-hall-grid" role="list">
                @foreach (var hall in Model.Halls)
                {
                    <li class="venue-hall-card">
                        <a class="venue-hall-card__link"
                           href="@hall.DetailHref"
                           aria-label="@($"Xem chi tiết {hall.Name} — Trung tâm Hội nghị Tiệc cưới Phì Lũ")">
                            <div class="venue-hall-card__media">
                                @if (!string.IsNullOrEmpty(hall.ImageUrl))
                                {
                                    <img src="@hall.ImageUrl"
                                         alt="@(hall.ImageAlt ?? $"{hall.Name} — Trung tâm Hội nghị Tiệc cưới Phì Lũ")"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="venue-hall-card__placeholder" aria-hidden="true">
                                        <span>Hình ảnh sẽ được cập nhật</span>
                                    </div>
                                }
                            </div>
                            <div class="venue-hall-card__body">
                                <p class="venue-hall-card__meta">@hall.Name</p>
                                @if (hall.CapacityMin.HasValue || hall.CapacityMax.HasValue)
                                {
                                    <p class="venue-hall-card__capacity">
                                        @FormatCapacity(hall.CapacityMin, hall.CapacityMax)
                                    </p>
                                }
                                <span class="link-arrow link-arrow--inline">
                                    Xem sảnh
                                    <span aria-hidden="true">&rarr;</span>
                                </span>
                            </div>
                        </a>
                    </li>
                }
            </ul>

            <div class="halls-page__cta">
                <a class="link-arrow halls-page__cta-back" asp-page="/TiecCuoi">
                    ← Chọn nhà hàng
                </a>
                <p class="halls-page__cta-note">
                    Bạn có thể liên hệ đội ngũ Phì Lũ để được tư vấn chi tiết về
                    sảnh tiệc phù hợp với quy mô buổi tiệc của mình.
                </p>
                <a class="btn btn--primary" asp-page="/DatTiec">
                    ĐẶT LỊCH TƯ VẤN
                    <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                </a>
            </div>
        }
    </div>
</section>

@functions {
    private static string FormatCapacity(int? min, int? max)
    {
        if (min.HasValue && max.HasValue)
        {
            return $"{min.Value:N0} – {max.Value:N0} khách";
        }
        if (max.HasValue)
        {
            return $"đến {max.Value:N0} khách";
        }
        if (min.HasValue)
        {
            return $"từ {min.Value:N0} khách";
        }
        return string.Empty;
    }
}
