@page "/tiec-cuoi/hall/{slug}"
@model PhiluWedding.Pages.TiecCuoi.HallModel
@{
    ViewData["Title"] = Model.Hall?.Name ?? "Sảnh tiệc cưới";
    ViewData["BackHref"] = Model.BackHref;
}

@section Styles {
    <link rel="stylesheet" href="~/css/halls.css" asp-append-version="true" />
}

@await Html.PartialAsync("_HallDetail", Model.Hall)
