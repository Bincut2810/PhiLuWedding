@* =====================================================================
   FLOATING CONTACT BUBBLES — Hotline, Facebook & Zalo
   Three stacked icon-only buttons in the bottom-right corner. They
   float above the page content and stay visible while scrolling.
   No external icon library: lightweight inline SVG is used so the
   page ships no extra dependency.

   The hotline number comes from configuration
   (Brand:Contact:HotlinePhone) so it can be changed without touching
   the markup; the Facebook URL and Zalo phone number follow the same
   convention (Brand:Contact:FacebookUrl / Brand:Contact:ZaloPhone).
   When the keys are missing the partial falls back to safe placeholder
   values.
   ===================================================================== *@
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var facebookUrl = Configuration["Brand:Contact:FacebookUrl"]
        ?? "https://www.facebook.com/share/1BqiX3HRck/";
    var zaloPhone = Configuration["Brand:Contact:ZaloPhone"] ?? "0989821022";
    var hotlinePhone = Configuration["Brand:Contact:HotlinePhone"] ?? "0905434115";

    // Public Zalo contact URL format is https://zalo.me/<phone> with
    // no separators, matching what Zalo's mobile and web apps
    // recognize.
    var zaloDigits = new string(zaloPhone.Where(char.IsDigit).ToArray());
    var zaloUrl = string.IsNullOrEmpty(zaloDigits)
        ? "https://zalo.me/"
        : $"https://zalo.me/{zaloDigits}";

    // The tel: link carries the number without separators, so the
    // dialer reads it correctly on every device.
    var hotlineDigits = new string(hotlinePhone.Where(char.IsDigit).ToArray());
    var hotlineTel = string.IsNullOrEmpty(hotlineDigits)
        ? "tel:"
        : $"tel:{hotlineDigits}";
}

<aside class="contact-bubbles" aria-label="Liên hệ nhanh">
    <div class="contact-bubbles__item">
        <a class="contact-bubbles__link contact-bubbles__link--hotline"
           href="@hotlineTel"
           aria-label="Gọi hotline @hotlinePhone của Nhà hàng tiệc cưới Phì Lũ">
            @* Classic handset glyph — the universal sign for a call
               action, so the bubble reads without any text. *@
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6.62 10.79a15.053 15.053 0 0 0 6.59 6.59l2.2-2.2a.996.996 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57c.11.35.03.74-.25 1.02l-2.2 2.2z" />
            </svg>
        </a>
        <span class="contact-bubbles__tooltip" role="tooltip">Hotline @hotlinePhone</span>
    </div>

    <div class="contact-bubbles__item">
        <a class="contact-bubbles__link contact-bubbles__link--facebook"
           href="@facebookUrl"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Mở trang Facebook của Nhà hàng tiệc cưới Phì Lũ trong cửa sổ mới">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07C2 17.1 5.66 21.27 10.44 22v-7.02H7.9v-2.91h2.54v-2.2c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22C18.34 21.27 22 17.1 22 12.07z" />
            </svg>
        </a>
        <span class="contact-bubbles__tooltip" role="tooltip">Facebook</span>
    </div>

    <div class="contact-bubbles__item">
        <a class="contact-bubbles__link contact-bubbles__link--zalo"
           href="@zaloUrl"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Mở cuộc trò chuyện Zalo với Nhà hàng tiệc cưới Phì Lũ trong cửa sổ mới">
            @* Official Zalo brand mark — the JPG is shipped from
               /wwwroot/images/logo/logoZalo.jpg so the icon stays
               pixel-identical to the source the design team
               approved, including the gradient and the speech-bubble
               shape. Rendered as an <img> so it scales cleanly inside
               the 52px bubble without any inline-SVG markup getting
               in the way. *@
            <img src="~/images/logo/logoZalo.jpg"
                 alt=""
                 asp-append-version="true"
                 width="866"
                 height="650" />
        </a>
        <span class="contact-bubbles__tooltip" role="tooltip">Chat Zalo</span>
    </div>
</aside>
