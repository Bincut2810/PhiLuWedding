@* =====================================================================
   FLOATING CONTACT BUBBLES — Facebook & Zalo
   Two stacked icon-only buttons in the bottom-right corner. They
   float above the page content and stay visible while scrolling.
   No external icon library: lightweight inline SVG is used so the
   page ships no extra dependency.

   The Facebook URL and Zalo phone number come from configuration
   (Brand:Contact:FacebookUrl / Brand:Contact:ZaloPhone) so the
   address can be changed without touching the markup. When the keys
   are missing the partial falls back to safe placeholder values.
   ===================================================================== *@
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var facebookUrl = Configuration["Brand:Contact:FacebookUrl"]
        ?? "https://www.facebook.com/share/1BqiX3HRck/";
    var zaloPhone = Configuration["Brand:Contact:ZaloPhone"] ?? "0989821022";

    // Public Zalo contact URL format is https://zalo.me/<phone> with
    // no separators, matching what Zalo's mobile and web apps
    // recognize.
    var zaloDigits = new string(zaloPhone.Where(char.IsDigit).ToArray());
    var zaloUrl = string.IsNullOrEmpty(zaloDigits)
        ? "https://zalo.me/"
        : $"https://zalo.me/{zaloDigits}";
}

<aside class="contact-bubbles" aria-label="Liên hệ nhanh qua mạng xã hội">
    <div class="contact-bubbles__item">
        <a class="contact-bubbles__link contact-bubbles__link--facebook"
           href="@facebookUrl"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Mở trang Facebook của Nhà hàng tiệc cưới Phì Lũ trong cửa sổ mới">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07C2 17.1 5.66 21.27 10.44 22v-7.02H7.9v-2.91h2.54v-2.2c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22C18.34 21.27 22 17.1 22 12.07z" />
            </svg>
        </a>
        <span class="contact-bubbles__tooltip" role="tooltip">Facebook</span>
    </div>

    <div class="contact-bubbles__item">
        <a class="contact-bubbles__link contact-bubbles__link--zalo"
           href="@zaloUrl"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Mở cuộc trò chuyện Zalo với Nhà hàng tiệc cưới Phì Lũ trong cửa sổ mới">
            @* Stylized "Z" mark drawn as a single stroked path on a
               generous viewBox so the lines stay crisp at any
               rendered size. The subtle upward flick at the end of
               the bottom bar echoes the official Zalo brand mark.
               currentColor on the stroke inherits from the link so
               the icon adapts to the bubble's hover state. *@
            <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <path d="M 17 17 H 47 L 17 47 H 38 Q 47 47 47 38"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>
        </a>
        <span class="contact-bubbles__tooltip" role="tooltip">Chat Zalo</span>
    </div>
</aside>