@using Microsoft.AspNetCore.Mvc.RazorPages
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var brandName = Configuration["Brand:Name"] ?? "NHÀ HÀNG PHÌ LŨ";
    var brandCity = Configuration["Brand:City"] ?? "Đà Nẵng";
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(pageTitle)
        ? $"{brandName} — Nhà Hàng Tiệc Cưới {brandCity}"
        : $"{pageTitle} — {brandName}";

    // Page-scoped body class so each page can pick its own background
    // (e.g. homepage uses a warm cream-yellow tint to make the venue
    // cards read as physical invitation cards resting on a surface).
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var bodyClass = currentPath switch
    {
        var p when string.Equals(p, "/", StringComparison.Ordinal)
                || string.Equals(p, "", StringComparison.Ordinal) => "page-home",
        _ => string.Empty
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@brandName — Nhà hàng tiệc cưới sang trọng tại Đà Nẵng. Không gian tinh tế, ẩm thực tinh hoa, dịch vụ tận tâm." />
    <title>@fullTitle</title>

    <!-- Fonts: Newsreader (display serif) + Source Sans 3 (body sans)
         Phase 02B. Both families are served from Google Fonts with the
         Vietnamese subset — they cover ă â ê ô ơ ư đ and every
         stacked accent. Only the weights the design system actually
         uses are requested — 400, 500 and 600, plus the italic 400
         that the single editorial accent and the italic notes need —
         so no extra font file is downloaded. `display=swap` keeps the
         text visible while the webfont arrives, and the fallback
         stacks in site.css keep a Vietnamese-capable face at every
         step. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400&amp;family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&amp&display=swap" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/venues.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyClass">
    <a class="skip-link" href="#main-content">Bỏ qua đến nội dung chính</a>

    @* Brand-mark page loader. Rendered before the header so it sits at
       the top of the visual stack on the very first paint; site.js
       hides it once the page is ready and animates it out again
       before intra-site navigation completes. *@
    @await Html.PartialAsync("_PageLoader")

    @await Html.PartialAsync("_Header")

    <main id="main-content" role="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    @* Floating contact bubbles (hotline + Facebook + Zalo). Always
       visible on public pages; the partial is a no-op markup when the
       brand configuration is missing the contact keys. *@
    @await Html.PartialAsync("_ContactBubbles")

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
