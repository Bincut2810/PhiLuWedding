@model PhiluWedding.Pages.ThucDon.MenuVenuePageModel
@{
    var tier = Model.SelectedTier;
}

@* =====================================================================
   PUBLIC WEDDING MENU — SHARED BODY
   Used by /thuc-don/philu and /thuc-don/golden-phoenix. Both venues
   read the same shared price tiers and the same menu options. Every
   wording below comes from the source price sheet, so nothing is
   invented here.
   ===================================================================== *@

<section class="menu-page" aria-labelledby="menu-page-heading">
    <div class="container">
        <header class="menu-page__head">
            <p class="eyebrow">THỰC ĐƠN TIỆC CƯỚI</p>
            <h1 id="menu-page-heading" class="menu-page__title">
                <span>@Model.VenueName</span>
            </h1>
            <p class="menu-page__lede">@Model.VenueIntro</p>
        </header>

        @if (!Model.DatabaseAvailable)
        {
            <div class="menu-page__notice" role="status">
                <p class="menu-page__notice-title">Hệ thống đang cập nhật bảng thực đơn.</p>
                <p class="menu-page__notice-body">
                    Vui lòng quay lại sau ít phút hoặc liên hệ trực tiếp với nhà hàng
                    để được tư vấn về thực đơn phù hợp.
                </p>
                <a class="link-arrow" asp-page="/DatTiec">
                    LIÊN HỆ TƯ VẤN
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        }
        else if (Model.CatalogEmpty)
        {
            <div class="menu-page__notice" role="status">
                <p class="menu-page__notice-title">Bảng thực đơn đang được hoàn thiện.</p>
                <p class="menu-page__notice-body">
                    Nhà hàng đang hoàn thiện thông tin cho từng mức giá. Xin vui lòng
                    quay lại sau hoặc liên hệ để được tư vấn.
                </p>
                <a class="link-arrow" asp-page="/DatTiec">
                    LIÊN HỆ TƯ VẤN
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        }
        else
        {
            @* ---------- Jump navigation ---------- *@
            <nav class="menu-jump" aria-label="Các mục của trang thực đơn">
                <ul class="menu-jump__list" role="list">
                    <li><a class="menu-jump__link" href="#menu-prices">Mức giá</a></li>
                    <li><a class="menu-jump__link" href="#menu-options">Phương án món ăn</a></li>
                    @if (Model.PriceNotes.Count > 0)
                    {
                        <li><a class="menu-jump__link" href="#menu-notes">Ghi chú về giá</a></li>
                    }
                </ul>
            </nav>

            @* ---------- Price tiers ---------- *@
            <section class="menu-section menu-section--tiers" id="menu-prices" aria-labelledby="menu-prices-heading">
                <p class="eyebrow">BẢNG GIÁ</p>
                <h2 id="menu-prices-heading" class="menu-section__title">Các mức giá thực đơn</h2>
                <p class="menu-section__lede">
                    Giá tính theo bàn @Model.Tiers[0].GuestsPerTable khách. Các mức giá và
                    phương án món ăn dưới đây được dùng chung cho
                    @Model.VenueName và @Model.OtherVenueName.
                </p>

                <ul class="menu-tiers" role="list">
                    @foreach (var menuTier in Model.Tiers)
                    {
                        var isCurrent = tier is not null
                            && string.Equals(menuTier.Slug, tier.Slug, StringComparison.OrdinalIgnoreCase);

                        <li class="menu-tier @(isCurrent ? "menu-tier--current" : null)">
                            <a class="menu-tier__link"
                               asp-page="@Model.VenuePage"
                               asp-route-muc="@menuTier.Slug"
                               aria-current="@(isCurrent ? "true" : null)">
                                <span class="menu-tier__price">
                                    @(menuTier.PriceDisplay ?? "Liên hệ nhà hàng")
                                </span>
                                <span class="menu-tier__unit">/ bàn @menuTier.GuestsPerTable khách</span>
                                <span class="menu-tier__name">@menuTier.Name</span>
                                @if (!string.IsNullOrWhiteSpace(menuTier.Description))
                                {
                                    <span class="menu-tier__desc">@menuTier.Description</span>
                                }
                                <span class="menu-tier__cta">
                                    Xem phương án
                                    <span aria-hidden="true">&rarr;</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </section>

            @* ---------- Options of the selected tier ---------- *@
            @if (tier is not null)
            {
                <section class="menu-section" id="menu-options" aria-labelledby="menu-options-heading">
                    <p class="eyebrow">PHƯƠNG ÁN MÓN ĂN</p>
                    <h2 id="menu-options-heading" class="menu-section__title">@tier.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(tier.Description))
                    {
                        <p class="menu-section__lede">@tier.Description</p>
                    }
                    @if (tier.IsSharedPrice)
                    {
                        <p class="menu-section__note">
                            Mức giá này là giá dùng chung, áp dụng cho cả
                            @Model.VenueName và @Model.OtherVenueName.
                        </p>
                    }

                    <div class="menu-options">
                        @foreach (var option in tier.Options)
                        {
                            <article class="menu-option">
                                <h3 class="menu-option__title">@option.ShortName</h3>
                                <ul class="menu-option__dishes" role="list">
                                    @foreach (var dish in option.Dishes)
                                    {
                                        <li class="menu-option__dish">
                                            <span class="menu-option__dish-name">@dish.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(dish.Note))
                                            {
                                                <span class="menu-option__dish-note">@dish.Note</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </article>
                        }
                    </div>
                </section>
            }

            @* ---------- Notes about the prices ---------- *@
            @if (Model.PriceNotes.Count > 0)
            {
                <section class="menu-section menu-section--notes" id="menu-notes" aria-labelledby="menu-notes-heading">
                    <p class="eyebrow">GHI CHÚ</p>
                    <h2 id="menu-notes-heading" class="menu-section__title">Ghi chú về giá</h2>
                    @foreach (var note in Model.PriceNotes)
                    {
                        <div class="menu-note">
                            <h3 class="menu-note__title">@note.Title</h3>
                            <p class="menu-note__body">@note.Content</p>
                            @if (!string.IsNullOrWhiteSpace(note.VatNote))
                            {
                                <p class="menu-note__meta">@note.VatNote</p>
                            }
                        </div>
                    }
                </section>
            }

            @* ---------- Call to action ---------- *@
            <section class="menu-cta" aria-labelledby="menu-cta-heading">
                <h2 id="menu-cta-heading" class="menu-cta__title">
                    Bạn muốn xem thực đơn này trong không gian nào?
                </h2>
                <p class="menu-cta__note">
                    Liên hệ để được tư vấn sảnh, mức giá và phương án món ăn phù hợp với
                    buổi tiệc của bạn.
                </p>
                <a class="btn btn--primary" asp-page="/DatTiec">
                    ĐẶT LỊCH TƯ VẤN
                    <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                </a>
                <div class="menu-cta__links">
                    <a class="link-arrow" asp-page="@Model.OtherVenuePage">
                        XEM THỰC ĐƠN @Model.OtherVenueName.ToUpperInvariant()
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                    <a class="link-arrow" asp-page="/ThucDon/Index">
                        CHỌN NHÀ HÀNG
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>
            </section>
        }
    </div>
</section>
