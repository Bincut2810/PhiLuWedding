@page "/tiec-cuoi"
@model PhiluWedding.Pages.TiecCuoiModel
@{
    ViewData["Title"] = "Sảnh tiệc cưới";
}

@section Styles {
    <link rel="stylesheet" href="~/css/halls.css" asp-append-version="true" />
}

@* =====================================================================
   PUBLIC WEDDING HALLS LISTING
   Reads from the database via TiecCuoiModel. The page renders a
   grid of cards; when the database is unavailable or has no rows yet,
   it shows a polite empty state instead of crashing.
   ===================================================================== *@

<section class="halls-page" aria-labelledby="halls-page-heading">
    <div class="container">
        <header class="halls-page__head">
            <p class="eyebrow">KHÔNG GIAN TIỆC CƯỚI</p>
            <h1 id="halls-page-heading" class="halls-page__title">
                <span>Mỗi sảnh tiệc,</span>
                <span>một câu chuyện riêng</span>
            </h1>
            <p class="halls-page__lede">
                Khám phá các không gian tiệc cưới của NHÀ HÀNG TIỆC CƯỚI PHÌ LŨ.
                Mỗi sảnh được chăm chút với phong cách riêng, sẵn sàng đồng hành
                cùng ngày trọng đại của bạn.
            </p>
        </header>

        @if (!Model.DatabaseAvailable)
        {
            <div class="halls-page__notice" role="status">
                <p class="halls-page__notice-title">Hệ thống đang cập nhật danh sách sảnh tiệc.</p>
                <p class="halls-page__notice-body">
                    Vui lòng quay lại sau ít phút hoặc liên hệ trực tiếp với nhà hàng
                    để được tư vấn về sảnh phù hợp.
                </p>
            </div>
        }
        else if (Model.Halls.Count == 0)
        {
            <div class="halls-page__notice" role="status">
                <p class="halls-page__notice-title">Danh sách sảnh tiệc đang được cập nhật.</p>
                <p class="halls-page__notice-body">
                    Nhà hàng đang hoàn thiện hình ảnh và thông tin cho từng sảnh.
                    Xin vui lòng quay lại sau hoặc liên hệ để được tư vấn.
                </p>
                <a class="link-arrow" asp-page="/DatTiec">
                    LIÊN HỆ TƯ VẤN
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        }
        else
        {
            <ul class="halls-page__grid" role="list">
                @foreach (var hall in Model.Halls)
                {
                    <li class="halls-card">
                        <a class="halls-card__link"
                           asp-page="/TiecCuoi/Details"
                           asp-route-id="@hall.Id"
                           aria-label="@($"Xem chi tiết {hall.Name}")">
                            <div class="halls-card__media">
                                @if (!string.IsNullOrEmpty(hall.ImageUrl))
                                {
                                    <img src="@hall.ImageUrl"
                                         alt="@(hall.ImageAlt ?? $"Không gian {hall.Name}")"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="halls-card__placeholder" aria-hidden="true">
                                        <span>Hình ảnh sẽ được cập nhật</span>
                                    </div>
                                }
                            </div>
                            <div class="halls-card__body">
                                <p class="halls-card__meta">@hall.Name</p>
                                @if (!string.IsNullOrWhiteSpace(hall.ShortDescription))
                                {
                                    <h2 class="halls-card__title">@hall.ShortDescription</h2>
                                }
                                else if (!string.IsNullOrWhiteSpace(hall.Description))
                                {
                                    <h2 class="halls-card__title">@hall.Description</h2>
                                }
                                else
                                {
                                    <h2 class="halls-card__title">Không gian tiệc cưới</h2>
                                }

                                @if (hall.CapacityMin.HasValue || hall.CapacityMax.HasValue)
                                {
                                    <p class="halls-card__meta-row">
                                        <span class="halls-card__meta-label">Sức chứa</span>
                                        <span class="halls-card__meta-value">
                                            @FormatCapacity(hall.CapacityMin, hall.CapacityMax)
                                        </span>
                                    </p>
                                }

                                <span class="link-arrow link-arrow--inline">
                                    Xem chi tiết
                                    <span aria-hidden="true">&rarr;</span>
                                </span>
                            </div>
                        </a>
                    </li>
                }
            </ul>

            <div class="halls-page__cta">
                <p class="halls-page__cta-note">
                    Mỗi sảnh có phong cách và sức chứa khác nhau. Hãy để đội ngũ
                    Phì Lũ giúp bạn chọn không gian phù hợp nhất.
                </p>
                <a class="btn btn--primary" asp-page="/DatTiec">
                    ĐẶT LỊCH TƯ VẤN
                    <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                </a>
                <a class="link-arrow halls-page__cta-secondary" asp-page="/Index">
                    VỀ TRANG CHỦ
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        }
    </div>
</section>

@functions {
    private static string FormatCapacity(int? min, int? max)
    {
        if (min.HasValue && max.HasValue)
        {
            return $"{min.Value} – {max.Value} khách";
        }
        if (max.HasValue)
        {
            return $"đến {max.Value} khách";
        }
        if (min.HasValue)
        {
            return $"từ {min.Value} khách";
        }
        return string.Empty;
    }
}