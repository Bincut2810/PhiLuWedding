@page "/tiec-cuoi"
@model PhiluWedding.Pages.TiecCuoiModel
@{
    ViewData["Title"] = "Không gian tiệc cưới";
}

@section Styles {
    <link rel="stylesheet" href="~/css/venues.css" asp-append-version="true" />
}

@* =====================================================================
   PUBLIC WEDDING VENUE SELECTION
   Customer journey step 1: the customer picks which wedding venue they
   want to explore. Each venue card links to its hall selection page
   (/tiec-cuoi/golden-phoenix, /tiec-cuoi/philu).
   ===================================================================== *@

<section class="venues-page" aria-labelledby="venues-page-heading">
    <div class="container">
        <header class="venues-page__head">
            <p class="eyebrow">KHÔNG GIAN TIỆC CƯỚI</p>
            <h1 id="venues-page-heading" class="venues-page__title">
                <span>Lựa chọn không gian phù hợp</span>
                <span>cho ngày trọng đại của bạn</span>
            </h1>
            <p class="venues-page__lede">
                NHÀ HÀNG TIỆC CƯỚI PHÌ Lũ hiện có hai không gian tiệc cưới.
                Mỗi nơi có phong cách và các sảnh tiệc riêng — hãy chọn
                không gian bạn muốn khám phá trước.
            </p>
        </header>

        <ul class="venues-page__grid" role="list">
            <li class="venue-card venue-card--page">
                <a class="venue-card__link"
                   asp-page="/TiecCuoi/GoldenPhoenix"
                   aria-label="Khám phá Golden Phoenix — nhà hàng tiệc cưới">
                    <div class="venue-card__media">
                        <img src="~/images/venues/golden-phoenix/cover.webp"
                             alt="Golden Phoenix — khu đón khách"
                             loading="eager"
                             fetchpriority="high"
                             asp-append-version="true" />
                    </div>
                    <div class="venue-card__body">
                        <p class="venue-card__meta">NHÀ HÀNG TIỆC CƯỚI</p>
                        <h2 class="venue-card__title">Golden Phoenix</h2>
                        <p class="venue-card__desc">Bốn sảnh tiệc theo từng sức chứa — từ tiệc nhỏ đến sự kiện lớn.</p>
                        <span class="link-arrow link-arrow--inline">
                            Khám phá sảnh
                            <span aria-hidden="true">&rarr;</span>
                        </span>
                    </div>
                </a>
            </li>
            <li class="venue-card venue-card--page">
                <a class="venue-card__link"
                   asp-page="/TiecCuoi/PhiLu"
                   aria-label="Khám phá Trung tâm Hội nghị Tiệc cưới Phì Lũ">
                    <div class="venue-card__media">
                        <img src="~/images/venues/philu/cover.webp"
                             alt="Trung tâm Hội nghị Tiệc cưới Phì Lũ — sảnh đón khách"
                             loading="eager"
                             fetchpriority="high"
                             asp-append-version="true" />
                    </div>
                    <div class="venue-card__body">
                        <p class="venue-card__meta">TRUNG TÂM HỘI NGHỊ TIỆC CƯỚI</p>
                        <h2 class="venue-card__title">Phì Lũ</h2>
                        <p class="venue-card__desc">Bốn sảnh Amber, Pearl, Diamond, Crystal — đa dạng phong cách và quy mô.</p>
                        <span class="link-arrow link-arrow--inline">
                            Khám phá sảnh
                            <span aria-hidden="true">&rarr;</span>
                        </span>
                    </div>
                </a>
            </li>
        </ul>

        <div class="venues-page__cta">
            <p class="venues-page__cta-note">
                Bạn có thể liên hệ đội ngũ Phì Lũ để được tư vấn không gian phù hợp nhất.
            </p>
            <a class="btn btn--primary" asp-page="/DatTiec">
                LIÊN HỆ TƯ VẤN
                <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="link-arrow venues-page__cta-home" asp-page="/Index">
                VỀ TRANG CHỦ
                <span aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </div>
</section>
